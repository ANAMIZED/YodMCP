# YodMCP environment (copy to .env and adjust)

# Memory: memory (in-process) | sqlite | durable
YODMCP_MEMORY_BACKEND=memory
YODMCP_MEMORY_DB=./data/yodmcp_memory.db

# System store for tasks / meter / entitlements / audit index
YODMCP_SYSTEM_DB=./data/yodmcp_system.db
YODMCP_TASKS_BACKEND=memory
YODMCP_METER_BACKEND=memory
YODMCP_AUDIT_BACKEND=jsonl

# Attestation: software | simulated_tee | nitro | sgx
YODMCP_ATTEST_MODE=software

# Plan + default tenant (overridden per-request via X-YodMCP-Tenant when authed)
YODMCP_PLAN=free
YODMCP_TENANT_ID=default

# Auth — required for multi-tenant SaaS. Comma-separated keys supported.
# YODMCP_API_KEY=dev-secret-change-me
# YODMCP_API_KEYS=key1,key2

# Rate limit (requests per minute per key/IP)
YODMCP_RATE_LIMIT_RPM=120

# HITL
# YODMCP_HITL_FAIL_CLOSED=false
# YODMCP_HITL_TTL_SECONDS=3600

# Input limits
# YODMCP_MAX_MEMORY_CONTENT=64000
# YODMCP_MAX_TOOL_ARG_BYTES=32000

# Global tool allowlist (comma names); empty = all default tools
# YODMCP_TOOL_ALLOWLIST=

# Logging: text | json
YODMCP_LOG_FORMAT=text
YODMCP_LOG_LEVEL=INFO
YODMCP_ENV=dev

# OpenTelemetry
# YODMCP_OTEL_CONSOLE=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Stripe
YODMCP_STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional skills directory override
# YODMCP_SKILLS_DIR=/path/to/skills
