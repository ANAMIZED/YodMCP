# YodMCP environment (copy to .env and adjust)

# Memory: memory (in-process) | sqlite | durable
YODMCP_MEMORY_BACKEND=memory
YODMCP_MEMORY_DB=./data/yodmcp_memory.db

# System store for tasks / meter / future entitlements (shares path with memory when convenient)
YODMCP_SYSTEM_DB=./data/yodmcp_system.db
YODMCP_TASKS_BACKEND=memory
YODMCP_METER_BACKEND=memory

# Attestation: software | simulated_tee | nitro | sgx
# nitro/sgx fall back to simulated unless real TEE providers are present
YODMCP_ATTEST_MODE=software

# Plan + tenant (soft quotas). Prefer request-scoped tenant via X-YodMCP-Tenant once auth is on.
YODMCP_PLAN=free
YODMCP_TENANT_ID=default

# Auth (P0). If set, API/A2A protected routes require Authorization: Bearer <key> or X-API-Key.
# Comma-separated for multiple keys. Leave empty for open dev mode.
# YODMCP_API_KEY=dev-secret-change-me
# YODMCP_API_KEYS=key1,key2

# Optional skills directory override (defaults: ./skills then package skills/)
# YODMCP_SKILLS_DIR=/path/to/skills

# Stripe (optional). Without STRIPE_SECRET_KEY, /api/billing/checkout returns payment links.
YODMCP_STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
