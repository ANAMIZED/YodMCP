# YodMCP environment (copy to .env and adjust)

# Memory: memory (in-process) | sqlite | durable
YODMCP_MEMORY_BACKEND=memory
YODMCP_MEMORY_DB=./data/yodmcp_memory.db

# Attestation: software | simulated_tee | nitro | sgx
# nitro/sgx fall back to simulated unless real TEE providers are present
YODMCP_ATTEST_MODE=software

# Plan + tenant (soft quotas)
YODMCP_PLAN=free
YODMCP_TENANT_ID=default

# Optional skills directory override (defaults: ./skills then package skills/)
# YODMCP_SKILLS_DIR=/path/to/skills

# Stripe (optional). Without STRIPE_SECRET_KEY, /api/billing/checkout returns payment links.
YODMCP_STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
